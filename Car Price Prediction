import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn import metrics


x = np.array([[10000], [15000], [20000], [25000], [30000],
              [35000], [40000], [45000], [50000], [55000],
              [60000], [65000], [70000], [75000], [80000]])

y = np.array([25000, 24000, 23000, 22000, 21000,
              20000, 19000, 18000, 17000, 16000,
              15000, 14000, 13000, 12000, 11000])


xtr, xte, ytr, yte = train_test_split(x, y, test_size=1/3, random_state=0)


regressor = LinearRegression()
regressor.fit(xtr, ytr)


yp = regressor.predict(xte)
xp = regressor.predict(xtr)


print("MAE:", metrics.mean_absolute_error(yte, yp))
print("MSE:", metrics.mean_squared_error(yte, yp))
print("RMSE:", np.sqrt(metrics.mean_squared_error(yte, yp)))


plt.scatter(xtr, ytr, color="green", label="Training Data")
plt.plot(xtr, xp, color="red", label="Regression Line")
plt.title("Car Price Prediction")
plt.xlabel("Mileage (in miles)")
plt.ylabel("Price (in dollars)")
plt.legend()
plt.grid(True)
plt.show()
