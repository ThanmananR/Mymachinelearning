import numpy as np 
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import LabelEncoder
from sklearn.model_selection import train_test_split
from sklearn import metrics
import math


data = pd.DataFrame({
    'sqft': [1200, 1500, 1800, 2400, 3000, 1700, 1100, 1300, 1600, 2200, 1400, 1900, 2500, 2800, 3200],
    'bedrooms': [2, 3, 3, 4, 5, 3, 2, 2, 3, 4, 3, 4, 4, 5, 5],
    'bathrooms': [1, 2, 2, 3, 4, 2, 1, 1, 2, 3, 2, 3, 3, 4, 4],
    'location': ['Downtown', 'Suburb', 'Suburb', 'City Center', 'City Center',
                 'Downtown', 'Suburb', 'Rural', 'Rural', 'City Center',
                 'Suburb', 'Downtown', 'City Center', 'Downtown', 'Rural'],
    'price': [250000, 300000, 350000, 500000, 600000, 340000, 230000, 240000, 310000, 470000,
              280000, 370000, 510000, 580000, 450000]
})


label_encoder = LabelEncoder()
data['location'] = label_encoder.fit_transform(data['location'])


x = data.iloc[:, :-1].values  # Features
y = data.iloc[:, -1].values   # Target


xtr, xte, ytr, yte = train_test_split(x, y, test_size=1/3, random_state=0)


regressor = LinearRegression()
regressor.fit(xtr, ytr)


yp_train = regressor.predict(xtr)
yp_test = regressor.predict(xte)


print("MAE:", metrics.mean_absolute_error(yte, yp_test))
print("MSE:", metrics.mean_squared_error(yte, yp_test))
print("RMSE:", math.sqrt(metrics.mean_squared_error(yte, yp_test)))


plt.scatter(yte, yp_test, color="red")
plt.plot([y.min(), y.max()], [y.min(), y.max()], 'k--', lw=2)
plt.title("Actual vs Predicted Selling Price (Test Set)")
plt.xlabel("Actual Price")
plt.ylabel("Predicted Price")
plt.show()


plt.scatter(ytr, yp_train, color="blue")
plt.plot([y.min(), y.max()], [y.min(), y.max()], 'k--', lw=2)
plt.title("Actual vs Predicted Selling Price (Train Set)")
plt.xlabel("Actual Price")
plt.ylabel("Predicted Price")
plt.show()
